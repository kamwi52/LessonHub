# ============================================================================
# LessonHub environment variables
# Copy this file to `.env.local` for local development.
# On Vercel, add the same three variables in:
#   Project -> Settings -> Environment Variables   (tick Production AND Preview)
# ============================================================================

# ---------------------------------------------------------------------------
# DATABASE_URL  (PostgreSQL)
# ---------------------------------------------------------------------------
# IMPORTANT for Supabase: use the *Connection Pooler* host, not `db.<ref>.supabase.co`.
#   - `db.<ref>.supabase.co` is IPv6-ONLY, so Vercel's IPv4 servers cannot reach it
#     and every API request fails with "500 Internal Server Error".
#   - The pooler has IPv4 and is what Supabase recommends for serverless anyway.
#
# Find yours at: Supabase -> Connect (top bar) -> ORMs / Connection string -> "Transaction pooler"
#
# Format:
#   postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
#
# URL-ENCODE the password! Common replacements:
#   @ -> %40     ? -> %3F     # -> %23     % -> %25     ! -> %21
#   + -> %2B     / -> %2F     : -> %3A     & -> %26     space -> %20
# Leave every other character as-is.
#
# Example (pooler, all special characters encoded):
DATABASE_URL=postgresql://postgres.abcdefghijklmnopqrst:My%40Password%21@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Local Docker Postgres alternative (no encoding needed, no SSL):
# DATABASE_URL=postgresql://lessonshub_user:lessonshub_password@localhost:5432/lessonshub_dev

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRY=7d

# ---------------------------------------------------------------------------
# Not needed any more
# ---------------------------------------------------------------------------
# API routes are built into this Next.js app at /api/*, so there is no
# separate backend URL to configure.

# ---------------------------------------------------------------------------
# Troubleshooting
# ---------------------------------------------------------------------------
# Open <your-deployment>/api/health in a browser. It reports exactly which
# variable is missing, whether the database is reachable, and whether the
# `users` / `plans` tables exist.

