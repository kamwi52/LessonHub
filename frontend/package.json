{
  "name": "lessonshub",
  "version": "0.1.0",
  "description": "Digital Lesson Plan & Scheme of Work System",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:init": "pg_isready || (echo 'Waiting for database...' && sleep 5)",
